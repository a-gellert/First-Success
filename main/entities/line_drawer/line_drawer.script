-- main/entities/line_drawer/line_drawer.script
-- Порт DrawManager из Unity:
-- public class DrawManager : MonoBehaviour
-- {
--     private Camera _cam;
--     [SerializeField] private Line _linePrefab;
--     public const float RESOLUTION = .1f;
--     private Line _currentLine;
--     ...
-- }

local camera = require("orthographic.camera")
local Line = require("main.entities.line.line")

-- Свойства компонента (аналог полей в инспекторе Unity)
go.property("resolution", 10)         -- RESOLUTION из юнити (минимальная дистанция для новой точки)
go.property("line_width", 12)         -- Ширина меша линии
go.property("scale_collider", 6)      -- scaleCollider из юнити (радиус коллайдера)
go.property("smooth_iterations", 1)   -- Количество итераций сглаживания кривой (0 - без сглаживания, 1-2 - сглаженная линия)
go.property("camera_id", hash("/camera"))

function init(self)
	-- _cam = Camera.main (сохраняем получение камеры через orthographic.camera)
	msg.post(".", "acquire_input_focus")

	-- Включаем автоматический зум камеры (automatic_zoom), чтобы игровое поле (320x480)
	-- корректно и пропорционально масштабировалось под любые разрешения и соотношения сторон экрана
	pcall(camera.set_automatic_zoom, self.camera_id, true)
	timer.delay(0.1, false, function()
		pcall(camera.set_automatic_zoom, self.camera_id, true)
	end)

	-- private Line _currentLine;
	self.current_line = nil
	self.is_drawing = false
end

-- Вспомогательная функция преобразования экранных координат в мировые
-- ВАЖНО: camera.screen_to_world ожидает реальные координаты окна (screen space),
-- которые находятся в action.screen_x и action.screen_y.
-- action.x и action.y привязаны к виртуальному display.width/height и при изменении разрешения дают смещение!
local function screen_to_world(self, action)
	if not action then return nil end
	local sx = action.screen_x or action.x
	local sy = action.screen_y or action.y
	if not sx or not sy then return nil end

	local wpos = camera.screen_to_world(self.camera_id, vmath.vector3(sx, sy, 0))
	if not wpos and self.camera_id ~= nil then
		-- Fallback на первую активную камеру
		wpos = camera.screen_to_world(nil, vmath.vector3(sx, sy, 0))
	end

	if wpos then
		wpos.z = 0.5
	end
	return wpos
end

function on_input(self, action_id, action)
	-- Получаем координаты курсора в мире через физические координаты окна (screen_x/screen_y)
	local mouse_pos = screen_to_world(self, action)
	if not mouse_pos then return end

	-- 1. if (Input.GetMouseButtonDown(0))
	--    _currentLine = Instantiate(_linePrefab, mousePos, Quaternion.identity);
	if action_id == hash("touch") and action.pressed then
		self.is_drawing = true

		-- Создаем новый GameObject линии через фабрику (_linePrefab)
		local line_id = factory.create("#line_mesh_factory", vmath.vector3(0, 0, 0))
		self.current_line = Line.new(line_id, vmath.vector3(0, 0, 0), self.line_width, self.scale_collider, self.resolution, self.smooth_iterations)

		-- Сразу регистрируем начальную точку линии
		self.current_line:set_position(mouse_pos)

	-- 2. if (Input.GetMouseButton(0))
	--    _currentLine.SetPosition(mousePos);
	-- В Defold перемещение мыши при зажатой кнопке передается с action_id == nil (десктоп) или hash("touch") (тач/веб)
	elseif (action_id == nil or action_id == hash("touch")) and self.is_drawing and not action.released then
		if self.current_line then
			self.current_line:set_position(mouse_pos)
		end

	-- 3. При отпускании мыши/тача завершаем рисование текущей линии
	elseif action_id == hash("touch") and action.released and self.is_drawing then
		self.is_drawing = false
		if self.current_line then
			-- Если нарисовано меньше 2 точек, полноценный сегмент не сформирован - удаляем
			if #self.current_line.points < 2 then
				self.current_line:destroy()
			end
			self.current_line = nil
		end
	end
end